{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kikyo",
  "version": "0.4.5",
  "identifier": "com.forestail.kikyo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kikyo",
        "width": 800,
        "height": 600,
        "visible": false,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "Japanese"
        ]
      }
    }
  }
}
